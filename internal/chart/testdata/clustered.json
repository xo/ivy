{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "autosize": {
    "contains": "padding",
    "type": "fit"
  },
  "config": {
    "axis": {
      "domainColor": "#bfbfbf",
      "gridColor": "#d9d9d9",
      "labelColor": "#595959",
      "labelFont": "Carlito",
      "labelFontSize": 9,
      "tickColor": "#bfbfbf",
      "titleColor": "#595959",
      "titleFont": "Carlito",
      "titleFontSize": 10,
      "titleFontWeight": "normal"
    },
    "axisBand": {
      "domainColor": "#bfbfbf",
      "gridColor": "#d9d9d9",
      "labelColor": "#595959",
      "labelFont": "Carlito",
      "labelFontSize": 9,
      "tickColor": "#bfbfbf",
      "titleColor": "#595959",
      "titleFont": "Carlito",
      "titleFontSize": 10,
      "titleFontWeight": "normal"
    },
    "background": "transparent",
    "font": "Carlito",
    "legend": {
      "labelColor": "#595959",
      "labelFont": "Carlito",
      "labelFontSize": 9,
      "symbolSize": 64.8,
      "symbolType": "square",
      "titleFont": "Carlito"
    },
    "style": {
      "arc": {
        "zuzu.hierarchy": false,
        "zuzu.total": false
      },
      "bar": {
        "zuzu.hierarchy": false
      },
      "line": {
        "zuzu.endLabel": false
      },
      "point": {
        "zuzu.hierarchy": false
      },
      "rect": {
        "zuzu.hierarchy": false,
        "zuzu.sankey": false
      },
      "text": {
        "font": "Carlito"
      },
      "zuzu.area": {
        "zuzu.gradient": false,
        "zuzu.markHigh": false,
        "zuzu.topLine": 0
      },
      "zuzu.area.stacked": {
        "fillOpacity": 1,
        "strokeWidth": 0
      },
      "zuzu.bar.horizontal": {
        "zuzu.cornerRadiusEnd": 0,
        "zuzu.hierarchy": false,
        "zuzu.stackGap": 0
      },
      "zuzu.bar.vertical": {
        "zuzu.cornerRadiusEnd": 0,
        "zuzu.hierarchy": false,
        "zuzu.stackGap": 0
      },
      "zuzu.curve": {
        "interpolate": "linear"
      },
      "zuzu.point": {
        "strokeWidth": 0
      }
    },
    "title": {
      "font": "Carlito",
      "subtitleFont": "Carlito"
    },
    "view": {
      "stroke": null
    }
  },
  "data": {
    "values": [
      {
        "c": "Q1",
        "i": 0,
        "k": 0,
        "l": "10",
        "p": 0,
        "s": "East",
        "v": 10
      },
      {
        "c": "Q2",
        "i": 1,
        "k": 0,
        "l": "14",
        "p": 0,
        "s": "East",
        "v": 14
      },
      {
        "c": "Q3",
        "i": 2,
        "k": 0,
        "l": "-3",
        "p": 0,
        "s": "East",
        "v": -3
      },
      {
        "c": "Q1",
        "i": 0,
        "k": 1,
        "l": "12",
        "p": 0,
        "s": "West",
        "v": 12
      },
      {
        "c": "Q2",
        "i": 1,
        "k": 1,
        "l": "8",
        "p": 0,
        "s": "West",
        "v": 8
      },
      {
        "c": "Q3",
        "i": 2,
        "k": 1,
        "l": "9",
        "p": 0,
        "s": "West",
        "v": 9
      }
    ]
  },
  "encoding": {
    "color": {
      "field": "s",
      "legend": {
        "orient": "bottom",
        "title": null
      },
      "scale": {
        "domain": [
          "East",
          "West"
        ],
        "range": [
          "#1f77b4",
          "#ff7f0e"
        ]
      },
      "type": "nominal"
    },
    "order": {
      "field": "k",
      "type": "quantitative"
    },
    "x": {
      "axis": {
        "domain": true,
        "grid": false,
        "labelAngle": 0,
        "labelPadding": 3,
        "orient": "bottom",
        "ticks": true
      },
      "field": "c",
      "scale": {
        "domain": [
          "Q1",
          "Q2",
          "Q3"
        ],
        "paddingInner": 0.4286,
        "paddingOuter": 0.2143
      },
      "title": null,
      "type": "nominal"
    },
    "xOffset": {
      "field": "s",
      "scale": {
        "domain": [
          "East",
          "West"
        ],
        "paddingInner": 0
      },
      "type": "nominal"
    },
    "y": {
      "axis": {
        "domain": false,
        "grid": true,
        "labelPadding": 4,
        "orient": "left",
        "ticks": false
      },
      "field": "v",
      "scale": {
        "zero": true
      },
      "stack": null,
      "title": null,
      "type": "quantitative"
    }
  },
  "height": 300,
  "mark": {
    "type": "bar"
  },
  "padding": 7.5,
  "title": {
    "anchor": "middle",
    "color": "#595959",
    "fontSize": 14,
    "fontWeight": "bold",
    "offset": 7,
    "text": "Sales by quarter"
  },
  "width": 400
}
