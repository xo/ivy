{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "autosize": {
    "contains": "padding",
    "type": "fit"
  },
  "config": {
    "axis": {
      "domainColor": "#bfbfbf",
      "gridColor": "#d9d9d9",
      "labelColor": "#595959",
      "labelFont": "Carlito",
      "labelFontSize": 9,
      "tickColor": "#bfbfbf",
      "titleColor": "#595959",
      "titleFont": "Carlito",
      "titleFontSize": 10,
      "titleFontWeight": "normal"
    },
    "axisBand": {
      "domainColor": "#bfbfbf",
      "gridColor": "#d9d9d9",
      "labelColor": "#595959",
      "labelFont": "Carlito",
      "labelFontSize": 9,
      "tickColor": "#bfbfbf",
      "titleColor": "#595959",
      "titleFont": "Carlito",
      "titleFontSize": 10,
      "titleFontWeight": "normal"
    },
    "background": "transparent",
    "font": "Carlito",
    "legend": {
      "labelColor": "#595959",
      "labelFont": "Carlito",
      "labelFontSize": 9,
      "symbolSize": 64.8,
      "symbolType": "square",
      "titleFont": "Carlito"
    },
    "style": {
      "arc": {
        "zuzu.hierarchy": false,
        "zuzu.total": false
      },
      "bar": {
        "zuzu.hierarchy": false
      },
      "line": {
        "zuzu.endLabel": false
      },
      "point": {
        "zuzu.hierarchy": false
      },
      "rect": {
        "zuzu.hierarchy": false,
        "zuzu.sankey": false
      },
      "text": {
        "font": "Carlito"
      },
      "zuzu.area": {
        "zuzu.gradient": false,
        "zuzu.markHigh": false,
        "zuzu.topLine": 0
      },
      "zuzu.area.stacked": {
        "fillOpacity": 1,
        "strokeWidth": 0
      },
      "zuzu.bar.horizontal": {
        "zuzu.cornerRadiusEnd": 0,
        "zuzu.hierarchy": false,
        "zuzu.stackGap": 0
      },
      "zuzu.bar.vertical": {
        "zuzu.cornerRadiusEnd": 0,
        "zuzu.hierarchy": false,
        "zuzu.stackGap": 0
      },
      "zuzu.curve": {
        "interpolate": "linear"
      },
      "zuzu.point": {
        "strokeWidth": 0
      }
    },
    "title": {
      "font": "Carlito",
      "subtitleFont": "Carlito"
    },
    "view": {
      "stroke": null
    }
  },
  "data": {
    "values": [
      {
        "i": 0,
        "k": 0,
        "p": 0,
        "s": "Height",
        "v": 10,
        "x": 1.5
      },
      {
        "i": 1,
        "k": 0,
        "p": 0,
        "s": "Height",
        "v": 12.5,
        "x": 2
      },
      {
        "i": 2,
        "k": 0,
        "p": 0,
        "s": "Height",
        "v": 9,
        "x": 3.25
      },
      {
        "i": 3,
        "k": 0,
        "p": 0,
        "s": "Height",
        "v": 15,
        "x": 4
      },
      {
        "i": 4,
        "k": 0,
        "p": 0,
        "s": "Height",
        "v": 20,
        "x": 5
      }
    ]
  },
  "encoding": {
    "color": {
      "field": "s",
      "legend": null,
      "scale": {
        "domain": [
          "Height"
        ],
        "range": [
          "#ff0000"
        ]
      },
      "type": "nominal"
    },
    "opacity": {
      "value": 1
    },
    "x": {
      "axis": {
        "domain": true,
        "grid": false,
        "labelPadding": 4,
        "orient": "bottom",
        "ticks": true
      },
      "field": "x",
      "scale": {
        "zero": true
      },
      "title": "Age",
      "type": "quantitative"
    },
    "y": {
      "axis": {
        "domain": false,
        "format": ".1f",
        "grid": true,
        "labelPadding": 4,
        "orient": "left",
        "ticks": false,
        "values": [
          0,
          5,
          10,
          15,
          20,
          25
        ]
      },
      "field": "v",
      "scale": {
        "domain": [
          0,
          25
        ],
        "nice": false,
        "zero": false
      },
      "title": null,
      "type": "quantitative"
    }
  },
  "height": 300,
  "mark": {
    "filled": true,
    "size": 36,
    "type": "point"
  },
  "padding": 7.5,
  "width": 400
}
